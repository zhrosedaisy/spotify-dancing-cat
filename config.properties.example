# Copy this file to config.properties and fill in your values.
spotify.clientId=YOUR_CLIENT_ID
spotify.redirectUri=http://127.0.0.1:8888/callback
# Fixed tempo used when live beat detection (audio capture) isn't available
dance.bpm=120
# Cat size: screen pixels per sprite pixel (2 = tiny, 3 = small, 5 = big)
cat.scale=3
