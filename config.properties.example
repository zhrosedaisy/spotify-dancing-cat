# Bu dosyayı config.properties adıyla kopyala ve değerleri doldur.
spotify.clientId=BURAYA_CLIENT_ID
spotify.redirectUri=http://127.0.0.1:8888/callback
# Canlı ritim (ses yakalama) yoksa kullanılan sabit tempo
dance.bpm=120
# Kedinin boyutu: her pixel kaç ekran pikseli olsun (2 = minik, 3 = küçük, 5 = büyük)
cat.scale=3
